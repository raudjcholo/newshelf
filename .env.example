# Browser-safe Supabase configuration. These values are included in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase API credential. Never expose this value to browser code.
SUPABASE_SECRET_KEY=

# Server-only transaction-pooler URL used by the deployed Next.js application.
SUPABASE_DATABASE_URL=

# Server-only direct or session-pooler URL used only by Drizzle Kit migrations.
SUPABASE_MIGRATION_DATABASE_URL=
